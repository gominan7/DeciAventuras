<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base de la aplicación; el color real se controla en Compose (ui/theme/Theme.kt) -->
    <style name="Theme.DeciAventuras" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/parchment_background</item>
        <item name="android:windowBackground">@color/parchment_background</item>
    </style>

    <!-- Tema de arranque para la MainActivity: evita el "flash" blanco mientras carga Compose -->
    <style name="Theme.DeciAventuras.Splash" parent="Theme.DeciAventuras">
        <item name="android:windowBackground">@color/jungle_green</item>
        <item name="android:statusBarColor">@color/jungle_green</item>
    </style>
</resources>
